# Server Configuration
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=BuildCrewCluster

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# Founder Administrators
ADMIN1_EMAIL=your_email@domain.com
ADMIN1_PASSWORD=your_secure_password
ADMIN2_EMAIL=collaborator_email@domain.com
ADMIN2_PASSWORD=collaborator_secure_password
